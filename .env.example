# Required API keys for the yt-to-site pipeline

# YouTube Data API v3 — for fetching channel videos
YOUTUBE_API_KEY=

# ClipScript (https://clipscript.uk) — for video transcription
CLIPSCRIPT_API_KEY=

# OpenRouter — for transcript formatting, translation, summarization, SEO
OPENROUTER_API_KEY=

# Cohere — for semantic embeddings (interlinking stage)
COHERE_API_KEY=
